//@version=5
indicator("Professional Trading Blueprint", shorttitle="PTB", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════
// INPUTS
// ══════════════════════════════════════════════════════════════════════════

// ── Market Structure ─────────────────────────────────────────────────────
grpStruct        = "Market Structure"
swingLen         = input.int(5, "Swing Lookback (bars)", minval=2, maxval=50, group=grpStruct)
showStructure    = input.bool(true, "Show HH/LL Labels", group=grpStruct)
showZigzag       = input.bool(true, "Show Structure Zigzag", group=grpStruct)
showBreaks       = input.bool(true, "Show BOS / MSS Labels", group=grpStruct)
bullStructColor  = input.color(color.new(color.teal, 0), "Bullish Structure Color", group=grpStruct)
bearStructColor  = input.color(color.new(color.red, 0), "Bearish Structure Color", group=grpStruct)
maxZigzag        = input.int(100, "Max Zigzag Segments Kept", minval=10, maxval=300, group=grpStruct)

// ── Order Blocks / Supply-Demand ─────────────────────────────────────────
grpOB            = "Order Blocks & Supply/Demand"
showOB           = input.bool(true, "Show Order Blocks", group=grpOB)
obSearchBars     = input.int(20, "OB Search Range (bars back)", minval=3, maxval=100, group=grpOB)
obExtendBars     = input.int(25, "OB Box Extend (bars right)", minval=5, maxval=200, group=grpOB)
maxOB            = input.int(6, "Max Order Blocks per Side", minval=1, maxval=30, group=grpOB)
demandColor      = input.color(color.new(color.blue, 80), "Demand Zone Color", group=grpOB)
supplyColor      = input.color(color.new(color.orange, 80), "Supply Zone Color", group=grpOB)
obBorderWidth    = input.int(1, "OB Border Width", minval=1, maxval=3, group=grpOB)

// ── Fair Value Gaps ───────────────────────────────────────────────────────
grpFVG           = "Imbalance (FVG)"
showFVG          = input.bool(true, "Show Fair Value Gaps", group=grpFVG)
fvgExtendBars    = input.int(15, "FVG Box Extend (bars right)", minval=1, maxval=100, group=grpFVG)
maxFVG           = input.int(15, "Max FVG Boxes per Side", minval=1, maxval=50, group=grpFVG)
bullFVGColor     = input.color(color.new(color.lime, 85), "Bullish FVG Color", group=grpFVG)
bearFVGColor     = input.color(color.new(color.fuchsia, 85), "Bearish FVG Color", group=grpFVG)

// ── Auto Fibonacci ────────────────────────────────────────────────────────
grpFib           = "Auto-Fibonacci"
showFib          = input.bool(true, "Show Auto-Fibonacci", group=grpFib)
showFib50        = input.bool(true, "Show 0.5", group=grpFib)
showFib71        = input.bool(true, "Show 0.71", group=grpFib)
showFib786       = input.bool(true, "Show 0.786", group=grpFib)
showFib886       = input.bool(true, "Show 0.886", group=grpFib)
showFibExt       = input.bool(true, "Show -0.27 Extension", group=grpFib)
fibColor         = input.color(color.new(color.yellow, 20), "Fibonacci Line Color", group=grpFib)
fibExtendBars    = input.int(30, "Fibonacci Extend (bars right)", minval=5, maxval=200, group=grpFib)

// ── Liquidity Sweeps ──────────────────────────────────────────────────────
grpSweep         = "Liquidity Sweeps"
showSweeps       = input.bool(true, "Show Liquidity Sweeps", group=grpSweep)
sweepColor       = input.color(color.new(color.white, 0), "Sweep Marker Color", group=grpSweep)

// ── Session Highlighter ───────────────────────────────────────────────────
grpSess          = "Session Highlighter"
showSessions     = input.bool(true, "Show Session Backgrounds", group=grpSess)
londonSession    = input.session("0900-1100", "London Session", group=grpSess)
nySession        = input.session("1400-1600", "New York Session", group=grpSess)
sessionTZ        = input.string("UTC", "Session Timezone (e.g. UTC, Europe/London, America/New_York)", group=grpSess)
londonColor      = input.color(color.new(color.blue, 92), "London Session Color", group=grpSess)
nyColor          = input.color(color.new(color.orange, 92), "New York Session Color", group=grpSess)

// ══════════════════════════════════════════════════════════════════════════
// STATE
// ══════════════════════════════════════════════════════════════════════════

var float lastPH    = na
var float lastPL    = na
var int   lastPHBar = na
var int   lastPLBar = na
var float prevPH    = na
var float prevPL    = na
var bool  phBroken   = true
var bool  plBroken   = true
var bool  phSwept    = false
var bool  plSwept    = false
var int   structTrend = 0   // 1 = bullish, -1 = bearish, 0 = undefined

var int   zzPrevBar   = na
var float zzPrevPrice = na
var line[] zigzagLines = array.new<line>()

var box[] demandBoxes = array.new<box>()
var box[] supplyBoxes = array.new<box>()

var box[] bullFVGBoxes = array.new<box>()
var box[] bearFVGBoxes = array.new<box>()

// Fibonacci objects are created once and updated in place — no growth over time.
var line[] fibLines  = array.new<line>(5, na)
var label[] fibLabels = array.new<label>(5, na)
var float[] fibRatios = array.from(0.5, 0.71, 0.786, 0.886, -0.27)
var string[] fibTexts = array.from("50%", "71%", "78.6%", "88.6%", "-27% Ext")

// ══════════════════════════════════════════════════════════════════════════
// PIVOTS
// ══════════════════════════════════════════════════════════════════════════

ph = ta.pivothigh(swingLen, swingLen)
pl = ta.pivotlow(swingLen, swingLen)

if not na(ph)
    phBar = bar_index - swingLen
    if showStructure
        isHH = na(prevPH) or ph > prevPH
        label.new(phBar, ph, isHH ? "HH" : "LH", xloc=xloc.bar_index, yloc=yloc.price,
             style=label.style_label_down, color=color.new(color.white, 100),
             textcolor=isHH ? bullStructColor : bearStructColor, size=size.small)
    if showZigzag
        if not na(zzPrevBar)
            ln = line.new(zzPrevBar, zzPrevPrice, phBar, ph, xloc=xloc.bar_index, color=color.gray, width=1)
            array.push(zigzagLines, ln)
            if array.size(zigzagLines) > maxZigzag
                line.delete(array.shift(zigzagLines))
        zzPrevBar := phBar
        zzPrevPrice := ph
    prevPH := ph
    lastPH := ph
    lastPHBar := phBar
    phBroken := false
    phSwept := false

if not na(pl)
    plBar = bar_index - swingLen
    if showStructure
        isLL = na(prevPL) or pl < prevPL
        label.new(plBar, pl, isLL ? "LL" : "HL", xloc=xloc.bar_index, yloc=yloc.price,
             style=label.style_label_up, color=color.new(color.white, 100),
             textcolor=isLL ? bearStructColor : bullStructColor, size=size.small)
    if showZigzag
        if not na(zzPrevBar)
            ln = line.new(zzPrevBar, zzPrevPrice, plBar, pl, xloc=xloc.bar_index, color=color.gray, width=1)
            array.push(zigzagLines, ln)
            if array.size(zigzagLines) > maxZigzag
                line.delete(array.shift(zigzagLines))
        zzPrevBar := plBar
        zzPrevPrice := pl
    prevPL := pl
    lastPL := pl
    lastPLBar := plBar
    plBroken := false
    plSwept := false

// ══════════════════════════════════════════════════════════════════════════
// LIQUIDITY SWEEPS — wick beyond a valid swing point without a close beyond it
// ══════════════════════════════════════════════════════════════════════════

sweepHighCond = showSweeps and not na(lastPH) and not phBroken and not phSwept and high > lastPH and close < lastPH
sweepLowCond  = showSweeps and not na(lastPL) and not plBroken and not plSwept and low < lastPL and close > lastPL

if sweepHighCond
    phSwept := true
if sweepLowCond
    plSwept := true

plotshape(sweepHighCond, style=shape.xcross, location=location.abovebar, color=sweepColor, size=size.tiny, offset=0)
plotshape(sweepLowCond, style=shape.xcross, location=location.belowbar, color=sweepColor, size=size.tiny, offset=0)

// ══════════════════════════════════════════════════════════════════════════
// ORDER BLOCK FINDER — last opposite-colored candle before the impulse
// ══════════════════════════════════════════════════════════════════════════

findOBOffset(fromBar, searchBars, bullishOB) =>
    startOffset = bar_index - fromBar
    maxOffset = math.min(bar_index, startOffset + searchBars)
    int found = na
    for off = startOffset to maxOffset
        bool isOpposite = bullishOB ? close[off] < open[off] : close[off] > open[off]
        if isOpposite
            found := off
            break
    found

// ══════════════════════════════════════════════════════════════════════════
// STRUCTURE BREAKS — BOS (continuation) / MSS (reversal), OB + Fibonacci
// ══════════════════════════════════════════════════════════════════════════

bullBreak = not na(lastPH) and not phBroken and close > lastPH
bearBreak = not na(lastPL) and not plBroken and close < lastPL

updateFib(p0, p1, extendBar) =>
    for i = 0 to array.size(fibRatios) - 1
        ratio = array.get(fibRatios, i)
        show  = (ratio == 0.5 and showFib50) or (ratio == 0.71 and showFib71) or
                 (ratio == 0.786 and showFib786) or (ratio == 0.886 and showFib886) or
                 (ratio == -0.27 and showFibExt)
        lvl = p0 - ratio * (p0 - p1)
        ln  = array.get(fibLines, i)
        lb  = array.get(fibLabels, i)
        if show
            if na(ln)
                newLn = line.new(bar_index, lvl, extendBar, lvl, xloc=xloc.bar_index, color=fibColor, width=1, style=line.style_dashed)
                array.set(fibLines, i, newLn)
                newLb = label.new(extendBar, lvl, array.get(fibTexts, i), xloc=xloc.bar_index, yloc=yloc.price,
                     style=label.style_label_left, color=color.new(color.white, 100), textcolor=fibColor, size=size.small)
                array.set(fibLabels, i, newLb)
            else
                line.set_xy1(ln, bar_index, lvl)
                line.set_xy2(ln, extendBar, lvl)
                label.set_xy(lb, extendBar, lvl)
        else
            if not na(ln)
                line.delete(ln)
                label.delete(lb)
                array.set(fibLines, i, na)
                array.set(fibLabels, i, na)

if bullBreak
    phBroken := true
    isReversal = structTrend == -1 or structTrend == 0
    if showBreaks
        label.new(bar_index, high, isReversal ? "MSS" : "BOS", xloc=xloc.bar_index, yloc=yloc.price,
             style=label.style_label_down, color=color.new(color.white, 100), textcolor=bullStructColor, size=size.small)
    structTrend := 1

    if showOB and not na(lastPLBar)
        offset = findOBOffset(lastPLBar, obSearchBars, true)
        if not na(offset)
            obBar = bar_index - offset
            b = box.new(obBar, high[offset], bar_index + obExtendBars, low[offset], border_color=color.blue,
                 border_width=obBorderWidth, bgcolor=demandColor, extend=extend.none)
            array.push(demandBoxes, b)
            if array.size(demandBoxes) > maxOB
                box.delete(array.shift(demandBoxes))

    if showFib and not na(lastPL)
        updateFib(lastPH, lastPL, bar_index + fibExtendBars)

if bearBreak
    plBroken := true
    isReversal = structTrend == 1 or structTrend == 0
    if showBreaks
        label.new(bar_index, low, isReversal ? "MSS" : "BOS", xloc=xloc.bar_index, yloc=yloc.price,
             style=label.style_label_up, color=color.new(color.white, 100), textcolor=bearStructColor, size=size.small)
    structTrend := -1

    if showOB and not na(lastPHBar)
        offset = findOBOffset(lastPHBar, obSearchBars, false)
        if not na(offset)
            obBar = bar_index - offset
            b = box.new(obBar, high[offset], bar_index + obExtendBars, low[offset], border_color=color.orange,
                 border_width=obBorderWidth, bgcolor=supplyColor, extend=extend.none)
            array.push(supplyBoxes, b)
            if array.size(supplyBoxes) > maxOB
                box.delete(array.shift(supplyBoxes))

    if showFib and not na(lastPH)
        updateFib(lastPL, lastPH, bar_index + fibExtendBars)

// ── Order block mitigation & extension (bounded loops — array size capped by maxOB) ──
if array.size(demandBoxes) > 0
    for i = array.size(demandBoxes) - 1 to 0
        b = array.get(demandBoxes, i)
        if low <= box.get_bottom(b)
            box.delete(b)
            array.remove(demandBoxes, i)
        else
            box.set_right(b, bar_index + obExtendBars)

if array.size(supplyBoxes) > 0
    for i = array.size(supplyBoxes) - 1 to 0
        b = array.get(supplyBoxes, i)
        if high >= box.get_top(b)
            box.delete(b)
            array.remove(supplyBoxes, i)
        else
            box.set_right(b, bar_index + obExtendBars)

// ══════════════════════════════════════════════════════════════════════════
// FAIR VALUE GAPS — 3-candle imbalance, shrinks as price fills it
// ══════════════════════════════════════════════════════════════════════════

bullFVG = showFVG and low > high[2]
bearFVG = showFVG and high < low[2]

if bullFVG
    b = box.new(bar_index - 2, low, bar_index + fvgExtendBars, high[2], border_color=na, bgcolor=bullFVGColor, extend=extend.none)
    array.push(bullFVGBoxes, b)
    if array.size(bullFVGBoxes) > maxFVG
        box.delete(array.shift(bullFVGBoxes))

if bearFVG
    b = box.new(bar_index - 2, low[2], bar_index + fvgExtendBars, high, border_color=na, bgcolor=bearFVGColor, extend=extend.none)
    array.push(bearFVGBoxes, b)
    if array.size(bearFVGBoxes) > maxFVG
        box.delete(array.shift(bearFVGBoxes))

if array.size(bullFVGBoxes) > 0
    for i = array.size(bullFVGBoxes) - 1 to 0
        b = array.get(bullFVGBoxes, i)
        top = box.get_top(b)
        bot = box.get_bottom(b)
        if low <= bot
            box.delete(b)
            array.remove(bullFVGBoxes, i)
        else
            box.set_top(b, math.min(top, low))
            box.set_right(b, bar_index + fvgExtendBars)

if array.size(bearFVGBoxes) > 0
    for i = array.size(bearFVGBoxes) - 1 to 0
        b = array.get(bearFVGBoxes, i)
        top = box.get_top(b)
        bot = box.get_bottom(b)
        if high >= top
            box.delete(b)
            array.remove(bearFVGBoxes, i)
        else
            box.set_bottom(b, math.max(bot, high))
            box.set_right(b, bar_index + fvgExtendBars)

// ══════════════════════════════════════════════════════════════════════════
// SESSION HIGHLIGHTER
// ══════════════════════════════════════════════════════════════════════════

inLondon = showSessions and not na(time(timeframe.period, londonSession, sessionTZ))
inNY     = showSessions and not na(time(timeframe.period, nySession, sessionTZ))

bgcolor(inLondon ? londonColor : na, title="London Session")
bgcolor(inNY ? nyColor : na, title="New York Session")
